# Copy to .env and fill in. .env is gitignored.

# Socrata app token for data.cityofnewyork.us. Requests work without one but
# throttle hard under load, so register one before the demo.
# https://data.cityofnewyork.us/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# MongoDB connection string (Atlas or local, e.g. mongodb://127.0.0.1:27017)
# REQUIRED. It used to be optional (cache only), but auth stores users and
# sessions here and the app now refuses to start without it.
MONGODB_URI=
MONGODB_DB=should-i-live-here

PORT=3001

# --- Auth --------------------------------------------------------------------
# Supabase handles sign-up/login/sessions directly with the frontend; this
# backend only verifies the access token a request carries. Both REQUIRED —
# the app exits at boot without them, same as MONGODB_URI.
#
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=
# Project Settings -> API Keys -> "Secret keys" (sb_secret_...). Backend-only —
# never expose this to the frontend or commit it.
SUPABASE_SECRET_KEY=

# --- AI explanation layer ----------------------------------------------------
# Entirely optional. With no provider configured every explanation falls back to
# a deterministic template and no endpoint changes behaviour or fails.

# "ollama" (local dev) or "gemini" (deployed). Defaults to ollama.
AI_PROVIDER=ollama

# Ollama: needs `ollama serve` running and the model pulled.
#   ollama pull llama3.1:8b
# CLAUDE.md specifies "llama3"; llama3.1:8b is the default because that is what
# was pulled on the dev machine. Either works — it is one variable.
OLLAMA_MODEL=llama3.1:8b
# Defaults to http://localhost:11434/api/generate. compose.yaml overrides this
# to host.docker.internal so a container can reach a host Ollama — see
# README.md.
# OLLAMA_ENDPOINT=http://localhost:11434/api/generate

# Gemini: set in the Vercel dashboard for deployment, NEVER commit a real key.
GEMINI_API_KEY=
# Default is gemini-3.5-flash-lite. NOTE: CLAUDE.md's gemini-2.5-flash-lite now
# returns 404 "no longer available to new users" — see documentation/m6.
GEMINI_MODEL=gemini-3.5-flash-lite
# Only needed for gemini-2.5-* models, which otherwise spend the whole output
# budget on thinking tokens and return a truncated fragment. Leave unset for 3.x.
# GEMINI_THINKING_BUDGET=0
